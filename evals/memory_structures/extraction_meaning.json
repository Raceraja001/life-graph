    {"id": "t09", "cat": "tamil", "text": "Naan ippo Coimbatore-la Saibaba Colony-la irukken.", "expect": [{"about": "owner", "must": [["coimbatore", "கோயம்புத்தூர்", "கோவை", "saibaba"]]}]},
    {"id": "t10", "cat": "tamil", "text": "என் கணவர் செந்தில் L&T-ல சைட் இன்ஜினியர்.", "expect": [{"about": "Senthil", "must": [["senthil", "செந்தில்"], ["l&t", "எல்&டி", "engineer", "இன்ஜினியர்"]]}], "never": ["owner is a site engineer", "owner works at l&t"]},
    {"id": "t11", "cat": "tamil", "text": "எனக்கு காபி பிடிக்காது, இஞ்சி டீ தான்.", "expect": [{"about": "owner", "must": [["coffee", "காபி"]], "negate": true}], "never": ["owner likes coffee", "owner drinks coffee", "owner loves coffee"]},
    {"id": "t12", "cat": "tamil", "text": "Amma-ku thyroid irukku, dhinamum maathirai saapiduvaanga.", "expect": [{"about": "owner", "must": [["thyroid", "தைராய்டு"]]}], "never": ["owner has thyroid", "owner takes thyroid", "owner has a thyroid"]},
    {"id": "t13", "cat": "tamil", "text": "Nila Pickles-la narthangai oorugai dhaan bestseller.", "expect": [{"about": "owner", "must": [["narthangai", "citron", "நார்த்தங்காய்"]]}]},
    {"id": "t14", "cat": "tamil", "text": "Indha varusham Hindi kathukalaamaa-nu yosikkiren.", "expect": [{"about": "owner", "must": [["hindi", "ஹிந்தி", "இந்தி"]], "hedged": true}], "never": ["owner is learning hindi", "owner speaks hindi", "owner started learning hindi"]},
    {"id": "t15", "cat": "tamil", "text": "Naan pottery class-ku poradhu niruthitten.", "expect": [{"about": "owner", "must": [["pottery", "மண்பாண்ட"]], "negate": true}], "never": ["owner attends pottery", "owner goes to pottery"]},
    {"id": "t16", "cat": "tamil", "text": "Badminton ippo Sunday kaalaila dhaan, Thursday illa.", "expect": [{"about": "owner", "must": [["badminton", "பேட்மிண்டன்"], ["sunday", "ஞாயிறு"]]}], "never": ["badminton on thursday", "plays on thursday"]},
    {"id": "t17", "cat": "tamil", "text": "என் தம்பி அருண் புனேல டேட்டா இன்ஜினியரா இருக்கான்.", "expect": [{"about": "Arun", "must": [["arun", "அருண்"], ["pune", "புனே", "data", "டேட்டா"]]}], "never": ["owner lives in pune", "owner is a data engineer"]},
    {"id": "t18", "cat": "tamil", "text": "Deepa-kku iPhone 16 Pro, enakku Pixel 10.", "expect": [{"about": "Deepa", "must": [["deepa"], ["iphone"]]}, {"about": "owner", "must": [["pixel"]]}], "never": ["owner uses an iphone", "owner's phone is an iphone", "owner has an iphone"]},
    {"id": "t19", "cat": "tamil", "text": "எங்க பொண்ணு நிலா மூணாவது படிக்கிறா.", "expect": [{"about": "Nila", "must": [["nila", "நிலா"], ["3", "three", "third", "மூணா", "மூன்றா"]]}]},
    {"id": "t20", "cat": "tamil", "text": "Ilan-ku inhaler ini thevai illa-nu doctor sonnaanga.", "expect": [{"about": "Ilan", "must": [["ilan", "இலன்"], ["inhaler"]], "negate": true}], "never": ["ilan needs an inhaler", "ilan uses an inhaler"]},
    {"id": "t21", "cat": "tamil", "text": "Senthil-ku kaaram konjam kooda pidikkadhu.", "expect": [{"about": "Senthil", "must": [["senthil"], ["spic", "kaaram", "காரம்", "hot food"]], "negate": true}], "never": ["owner dislikes spicy", "owner doesn't like spicy", "owner does not like spicy", "senthil likes spicy"]},
    {"id": "t22", "cat": "tamil", "text": "Naan SIP-a 9,000-ku yethiten.", "expect": [{"about": "owner", "must": [["9,000", "9000"], ["sip"]]}]},
    {"id": "t23", "cat": "tamil", "text": "En blood group O negative.", "expect": [{"about": "owner", "must": [["o negative", "o-", "o -ve", "o neg"]]}]},
    {"id": "t24", "cat": "tamil", "text": "Theriyala, December-ku Ooty-aa Yercaud-aa-nu.", "expect": [{"about": "owner", "must": [["ooty", "yercaud"]], "hedged": true}], "never": ["going to ooty in december", "going to yercaud in december", "will go to ooty", "will go to yercaud"]},
    {"id": "t25", "cat": "tamil", "text": "Saturday-la naan non-veg saapida maatten.", "expect": [{"about": "owner", "must": [["non-veg", "non veg", "nonveg", "meat", "அசைவ"]], "negate": true}], "never": ["owner eats non-veg on saturday"]},
    {"id": "t26", "cat": "tamil", "text": "நாங்க மதுரையை விட்டு கோவைக்கு வந்தது என் புது வேலைக்காக தான்.", "expect": [{"about": "owner", "must": [["coimbatore", "கோவை", "கோயம்புத்தூர்"]], "reason": [["job", "work", "வேலை"]]}]},
    {"id": "t27", "cat": "tamil", "text": "Glass jar ellam udanjuduchu, adhanala Tamil Nadu-ku veliya ship panradhu niruthitom.", "expect": [{"about": "owner", "must": [["ship", "courier", "deliver", "அனுப்ப"]], "negate": true, "reason": [["jar", "broke", "break", "glass", "உடை"]]}]},
    {"id": "t28", "cat": "tamil", "text": "Lakshmi ippo Bangalore-la Brightloop-la velai seiraanga.", "expect": [{"about": "Lakshmi", "must": [["lakshmi"], ["brightloop"]]}], "never": ["owner works at brightloop", "owner lives in bangalore"]},
    {"id": "t29", "cat": "tamil", "text": "Appa dhinamum kaalaila anju manikku walking poovaaru.", "expect": [{"about": "owner", "must": [["walk", "நட"], ["5", "five", "ஐந்து", "அஞ்சு"]]}], "never": ["owner walks at 5", "owner goes for a walk at 5", "owner walks every morning"]},
    {"id": "t30", "cat": "tamil", "text": "Ma-oda friends ellarum avangala Maha-nu dhaan kooppiduvaanga.", "expect": [{"about": "owner", "must": [["maha"]]}], "never": ["owner is called maha", "owner goes by maha"]},
    {"id": "t31", "cat": "tamil", "text": "Ennoda manager Deepa Iyer, munnadi Zoho-la irundhaanga.", "expect": [{"about": "owner", "must": [["deepa"], ["manager", "boss"]]}, {"about": "Deepa", "must": [["deepa"], ["zoho"]]}], "never": ["owner worked at zoho", "owner previously worked at zoho"]},
    {"id": "t32", "cat": "tamil", "text": "Ippo naan Instagram-la pickles vikkiradhu illa, WhatsApp dhaan.", "expect": [{"about": "owner", "must": [["instagram"]], "negate": true}], "never": ["owner sells pickles on instagram", "owner sells on instagram"]},
    {"id": "t33", "cat": "tamil", "text": "Amazon-la vikkalaamaa-nu yosichitu irukken, Deepavali-ku apram paakalaam.", "expect": [{"about": "owner", "must": [["amazon"]], "hedged": true}], "never": ["owner sells on amazon", "owner sells pickles on amazon", "owner started selling on amazon"]},
    {"id": "t34", "cat": "tamil", "text": "Sorry, Rekha madam class Wednesday illa, Friday raathiri.", "expect": [{"about": "owner", "must": [["friday", "வெள்ளி"]], "correction": true}], "never": ["class is on wednesday", "on wednesday nights", "class on wednesday"]},
    {"id": "t35", "cat": "tamil", "text": "KR-um peru Kavitha dhaan, aana avanga junior tester.", "expect": [{"about": "KR", "must": [["kr", "kavitha raman"], ["tester"]]}], "never": ["owner is a junior tester"]},
    {"id": "t36", "cat": "tamil", "text": "எனக்கு மல்லிகையை விட கனகாம்பரம் தான் பிடிக்கும்.", "expect": [{"about": "owner", "must": [["kanakambaram", "கனகாம்பரம்", "crossandra"]]}], "never": ["owner's favourite flower is jasmine", "owner prefers jasmine"]},
    {"id": "t37", "cat": "tamil", "text": "Senthil-a Chennai-ku maathalaam-nu L&T sollirukkaanga, innum confirm aagala.", "expect": [{"about": "Senthil", "must": [["senthil"], ["chennai"]], "hedged": true}], "never": ["senthil is moving to chennai", "owner is moving to chennai", "senthil will move to chennai", "senthil has been transferred"]},
    {"id": "t38", "cat": "tamil", "text": "Ennoda maamiyaar Pushpa Madurai Anna Nagar-la sondha veetla irukkaanga.", "expect": [{"about": "Pushpa", "must": [["pushpa"], ["anna nagar", "madurai"]]}], "never": ["owner lives in anna nagar", "owner owns a house"]},
    {"id": "a01", "cat": "alias", "text": "My mother Mahalakshmi (I call her Ma) has bad knee pain.", "expect": [{"about": "owner", "must": [["knee"], ["mahalakshmi", "mother"]]}], "never": ["owner has knee pain", "owner has bad knee"]},
    {"id": "a02", "cat": "alias", "text": "Maha is coming to stay with us next week; that's what her friends call Ma.", "expect": [{"about": "owner", "must": [["maha", "mother", "ma "], ["stay", "visit", "coming"]]}]},
    {"id": "a03", "cat": "alias", "text": "Kutty (that's Ilan) started at Little Steps daycare.", "expect": [{"about": "Ilan", "must": [["ilan"], ["little steps", "daycare"]]}]},
    {"id": "a04", "cat": "alias", "text": "Senthilkumar is my husband; everyone just calls him Senthil.", "expect": [{"about": "Senthil", "must": [["senthil"], ["husband"]]}]},
    {"id": "a05", "cat": "alias", "text": "Everyone at the office calls me Kavi now.", "expect": [{"about": "owner", "must": [["kavi"]]}]},
    {"id": "a06", "cat": "alias", "text": "Deepa Iyer (my boss, not my friend Deepa Sekar) approved my leave for Deepavali.", "expect": [{"about": "Deepa Iyer", "must": [["deepa iyer"], ["approv", "leave"]]}], "never": ["deepa sekar approved", "owner's boss is deepa sekar", "deepa sekar is the owner's boss"]},
    {"id": "a07", "cat": "alias", "text": "KR, that's Kavitha Raman on my team, is taking over the login tests.", "expect": [{"about": "KR", "must": [["kr", "kavitha raman"], ["login"]]}], "never": ["owner is taking over the login tests"]},
    {"id": "a08", "cat": "alias", "text": "Appa, Subramanian sir to his old students, turned 70 today.", "expect": [{"about": "owner", "must": [["70"], ["subramanian", "father", "appa"]]}], "never": ["owner turned 70", "owner is 70"]},
    {"id": "a09", "cat": "alias", "text": "Two Lakshmis in my life: my college friend Lakshmi works at Brightloop, and Lakshmi aunty next door sells flowers.", "expect": [{"about": "Lakshmi", "must": [["lakshmi"], ["brightloop"]]}, {"about": "Lakshmi", "must": [["lakshmi"], ["flower"]]}], "never": ["brightloop and sells flowers", "owner sells flowers", "owner works at brightloop"]},
    {"id": "a10", "cat": "alias", "text": "Prakash anna, my old manager at Velan, just became a director there.", "expect": [{"about": "Prakash", "must": [["prakash"], ["director"]]}], "never": ["owner became a director", "owner is a director"]},

    {"id": "a11", "cat": "alias", "text": "Thatha, that's Senthil's appa, lives with Pushpa in Madurai.", "expect": [{"about": "owner", "must": [["madurai"], ["pushpa", "senthil"]]}], "never": ["owner lives in madurai", "owner lives with pushpa"]},
    {"id": "a12", "cat": "alias", "text": "Our neighbour Mr. Raghavan, we call him Raghu uncle, has a lovely terrace garden.", "expect": [{"about": "Ragh", "must": [["ragh"], ["garden"]]}], "never": ["owner has a terrace garden", "owner's terrace garden"]},
    {"id": "a13", "cat": "alias", "text": "My little one Ilan, Kutty as we call him, is scared of dogs.", "expect": [{"about": "Ilan", "must": [["ilan", "kutty"], ["dog"]]}], "never": ["owner is scared of dogs"]},
    {"id": "a14", "cat": "alias", "text": "Swathi is Arun's wife, so she's my anni.", "expect": [{"about": "Swathi", "must": [["swathi"], ["arun", "sister-in-law", "wife", "anni"]]}], "never": ["owner is arun's wife"]},
    {"id": "a15", "cat": "alias", "text": "Nila's Bharatanatyam teacher is Gomathi miss; the kids call her Akka.", "expect": [{"about": "Gomathi", "must": [["gomathi"], ["bharatanatyam", "dance", "teacher"]]}], "never": ["owner learns bharatanatyam", "owner's teacher is gomathi"]},
    {"id": "s13", "cat": "subject", "text": "My colleague KR drinks three cups of coffee a day.", "expect": [{"about": "KR", "must": [["kr"], ["coffee"]]}], "never": ["owner drinks three cups", "owner drinks coffee"]},
    {"id": "s14", "cat": "subject", "text": "Deepa Sekar bought a Hyundai i20.", "expect": [{"about": "Deepa", "must": [["deepa"], ["i20"]]}], "never": ["owner bought a hyundai", "owner's car is a hyundai", "owner drives a hyundai"]},
    {"id": "s15", "cat": "subject", "text": "Senthil plays cricket every Sunday with his office team.", "expect": [{"about": "Senthil", "must": [["senthil"], ["cricket"]]}], "never": ["owner plays cricket"]},
    {"id": "s16", "cat": "subject", "text": "Arun switched to a OnePlus 13.", "expect": [{"about": "Arun", "must": [["arun"], ["oneplus", "one plus"]]}], "never": ["owner switched to a oneplus", "owner uses a oneplus", "owner's phone is a oneplus"]},
    {"id": "s17", "cat": "subject", "text": "Senthil's brother Murali works as an electrician in Dubai.", "expect": [{"about": "Murali", "must": [["murali"], ["electrician", "dubai"]]}], "never": ["owner is an electrician", "owner lives in dubai", "senthil is an electrician"]},
    {"id": "s18", "cat": "subject", "text": "Revathi, our old neighbour, teaches chemistry at Madurai Kamaraj University.", "expect": [{"about": "Revathi", "must": [["revathi"], ["chemistry"]]}], "never": ["owner teaches chemistry", "owner teaches at"]},
    {"id": "s19", "cat": "subject", "text": "Swathi is a physiotherapist in Pune.", "expect": [{"about": "Swathi", "must": [["swathi"], ["physio"]]}], "never": ["owner is a physiotherapist"]},
    {"id": "s20", "cat": "subject", "text": "Lakshmi's husband is a cardiologist.", "expect": [{"about": "Lakshmi", "must": [["lakshmi"], ["cardiolog"]]}], "never": ["owner's husband is a cardiologist", "senthil is a cardiologist"]},
    {"id": "s21", "cat": "subject", "text": "My friend Deepa wants to open a second shop in Trichy.", "expect": [{"about": "Deepa", "must": [["deepa"], ["trichy"]]}], "never": ["owner wants to open", "owner is opening a shop"]},
    {"id": "s22", "cat": "subject", "text": "Ganesh, Senthil's friend, bought a flat in Velachery, Chennai.", "expect": [{"about": "Ganesh", "must": [["ganesh"], ["velachery", "flat"]]}], "never": ["owner bought a flat", "senthil bought a flat", "owner lives in velachery"]},
    {"id": "s23", "cat": "subject", "text": "KR's husband works at a bank in Tiruppur.", "expect": [{"about": "KR", "must": [["kr"], ["bank"]]}], "never": ["owner's husband works at a bank", "senthil works at a bank"]},
    {"id": "s24", "cat": "subject", "text": "Nila's friend Diya is allergic to peanuts.", "expect": [{"about": "Diya", "must": [["diya"], ["peanut"]]}], "never": ["nila is allergic", "owner is allergic"]},
    {"id": "s25", "cat": "subject", "text": "Ma takes a Thyronorm tablet every morning.", "expect": [{"about": "owner", "must": [["thyronorm"]]}], "never": ["owner takes thyronorm", "owner takes a thyronorm"]},
    {"id": "s26", "cat": "subject", "text": "Deepa Iyer's son plays chess at the district level.", "expect": [{"about": "Deepa", "must": [["deepa"], ["chess"]]}], "never": ["owner plays chess", "owner's son plays chess", "ilan plays chess"]},
    {"id": "s27", "cat": "subject", "text": "Pushpa goes to the Meenakshi temple every Friday.", "expect": [{"about": "Pushpa", "must": [["pushpa"], ["temple", "meenakshi"]]}], "never": ["owner goes to the meenakshi temple"]},
    {"id": "s28", "cat": "subject", "text": "Murali bought a new car in Dubai.", "expect": [{"about": "Murali", "must": [["murali"], ["car"]]}], "never": ["owner bought a new car", "owner bought a car"]},
    {"id": "s29", "cat": "subject", "text": "Prakash at Velan still uses a BlackBerry, can you believe it.", "expect": [{"about": "Prakash", "must": [["prakash"], ["blackberry"]]}], "never": ["owner uses a blackberry"]},
    {"id": "s30", "cat": "subject", "text": "Arun is thinking of moving to Bangalore.", "expect": [{"about": "Arun", "must": [["arun"], ["bangalore", "bengaluru"]], "hedged": true}], "never": ["arun is moving to bangalore", "arun lives in bangalore", "owner is moving to bangalore"]},
    {"id": "s31", "cat": "subject", "text": "Senthil hates long drives; I love them.", "expect": [{"about": "Senthil", "must": [["senthil"], ["drive"]], "negate": true}, {"about": "owner", "must": [["drive"]]}], "never": ["owner hates long drives", "senthil loves long drives"]},
    {"id": "s32", "cat": "subject", "text": "The other Kavitha on my team, KR, is getting married in December.", "expect": [{"about": "KR", "must": [["kr", "kavitha raman"], ["marr", "wedding"]]}], "never": ["owner is getting married"]},
    {"id": "c09", "cat": "correction", "text": "I said Tuesday, I meant Thursday: badminton is on Thursday evenings.", "expect": [{"about": "owner", "must": [["thursday"]], "correction": true}], "never": ["badminton is on tuesday", "badminton on tuesday"]},
    {"id": "c10", "cat": "correction", "text": "No wait, I made the SIP 9,000, not 8,000.", "expect": [{"about": "owner", "must": [["9,000", "9000"]], "correction": true}], "never": ["sip is 8,000", "sip of 8,000", "8,000 a month", "8000 a month"]},
    {"id": "c11", "cat": "correction", "text": "Correction: Nila's PTA meeting is on 14 November, not the 7th.", "expect": [{"about": "Nila", "must": [["nila"], ["14"]], "correction": true}], "never": ["meeting is on 7 november", "meeting is on november 7", "meeting is on the 7th"]},
    {"id": "c12", "cat": "correction", "text": "Sorry, the rent is 22,000, not 20,000.", "expect": [{"about": "owner", "must": [["22,000", "22000"]], "correction": true}], "never": ["rent is 20,000", "rent is 20000"]},
    {"id": "c13", "cat": "correction", "text": "Actually the Yercaud cottage is from the 20th to the 23rd, not the 21st to the 24th.", "expect": [{"about": "owner", "must": [["yercaud", "cottage"], ["20"], ["23"]], "correction": true}], "never": ["from the 21st to the 24th", "21 to 24"]},
    {"id": "c14", "cat": "correction", "text": "It's Dr. Shanthi, not Dr. Shanta, at Kidz Care.", "expect": [{"about": "owner", "must": [["shanthi"]], "correction": true}], "never": ["is dr. shanta", "dr. shanta at kidz care"]},
    {"id": "c15", "cat": "correction", "text": "My mistake, Ma's birthday is 30 November, not 30 October.", "expect": [{"about": "owner", "must": [["30 november", "november 30", "30th november", "30 nov"]], "correction": true}], "never": ["birthday is 30 october", "birthday is on 30 october", "birthday is october 30"]},
    {"id": "c16", "cat": "correction", "text": "No, the Samsung went to Senthil, not to Ma.", "expect": [{"about": "Senthil", "must": [["senthil"], ["samsung"]], "correction": true}], "never": ["samsung went to ma", "mother got the samsung", "ma got the samsung"]},
    {"id": "c17", "cat": "correction", "text": "I was wrong earlier: Deepa Iyer worked at Zoho, not Freshworks.", "expect": [{"about": "Deepa", "must": [["deepa"], ["zoho"]], "correction": true}], "never": ["worked at freshworks"]},
    {"id": "c18", "cat": "correction", "text": "Not Kodaikanal; the April trip was to Rameswaram.", "expect": [{"about": "owner", "must": [["rameswaram"]], "correction": true}], "never": ["trip was to kodaikanal", "april trip to kodaikanal"]},
    {"id": "c19", "cat": "correction", "text": "Ilan is 2, not 3; he was born in January 2024.", "expect": [{"about": "Ilan", "must": [["ilan"], ["2"]], "correction": true}], "never": ["ilan is 3", "is 3 years old"]},
    {"id": "c20", "cat": "correction", "text": "Correction: my title is Senior QA Manager, not QA Lead, since February.", "expect": [{"about": "owner", "must": [["qa manager"]], "correction": true}], "never": ["owner is a qa lead", "title is qa lead"]},
    {"id": "c21", "cat": "correction", "text": "Sorry, Murali is in Dubai, not Doha.", "expect": [{"about": "Murali", "must": [["murali"], ["dubai"]], "correction": true}], "never": ["murali is in doha", "murali lives in doha"]},
    {"id": "c22", "cat": "correction", "text": "I said 120 jars, I meant 120 orders in July.", "expect": [{"about": "owner", "must": [["120"], ["order"]], "correction": true}], "never": ["120 jars"]},
    {"id": "c23", "cat": "correction", "text": "Redmi illa, Samsung dhaan en pazhaya phone.", "expect": [{"about": "owner", "must": [["samsung", "சாம்சங்"]], "correction": true}], "never": ["old phone was a redmi", "old phone is a redmi", "previous phone was a redmi"]},

    {"id": "h13", "cat": "hedge", "text": "Maybe I'll join a gym near Saibaba Colony. Haven't decided.", "expect": [{"about": "owner", "must": [["gym"]], "hedged": true}], "never": ["owner joined a gym", "owner goes to the gym", "owner goes to a gym"]},
    {"id": "h14", "cat": "hedge", "text": "Thinking about selling the pickles on Amazon, maybe after Deepavali.", "expect": [{"about": "owner", "must": [["amazon"]], "hedged": true}], "never": ["owner sells on amazon", "sells pickles on amazon", "owner started selling on amazon"]},
    {"id": "h15", "cat": "hedge", "text": "Arun and Swathi might visit us at Christmas, not confirmed.", "expect": [{"about": "Arun", "must": [["arun"], ["christmas"]], "hedged": true}], "never": ["arun and swathi will visit", "are visiting at christmas", "will visit at christmas"]},
    {"id": "h16", "cat": "hedge", "text": "Planning the December holiday: maybe Ooty, maybe Yercaud.", "expect": [{"about": "owner", "must": [["ooty", "yercaud"]], "hedged": true}], "never": ["going to ooty in december", "going to yercaud in december", "will go to ooty", "will go to yercaud"]},
    {"id": "h17", "cat": "hedge", "text": "I might switch my SIP to a different fund next year.", "expect": [{"about": "owner", "must": [["sip", "fund"]], "hedged": true}], "never": ["owner switched the sip", "owner switched funds", "owner switched to a different fund"]},
    {"id": "h18", "cat": "hedge", "text": "Thinking of putting Ilan in swimming classes when he turns three.", "expect": [{"about": "Ilan", "must": [["ilan"], ["swim"]], "hedged": true}], "never": ["ilan goes to swimming", "ilan attends swimming", "ilan is in swimming"]},
    {"id": "h19", "cat": "hedge", "text": "Not sure whether to renew the car insurance with the same company.", "expect": [{"about": "owner", "must": [["insurance"]], "hedged": true}], "never": ["owner renewed the car insurance", "owner will renew"]},
    {"id": "h20", "cat": "hedge", "text": "Perhaps we'll buy our own flat in Coimbatore in a couple of years.", "expect": [{"about": "owner", "must": [["flat", "house", "home"]], "hedged": true}], "never": ["owner bought a flat", "owner owns a flat", "owner will buy a flat"]},
    {"id": "h21", "cat": "hedge", "text": "Considering a second car, maybe an electric one.", "expect": [{"about": "owner", "must": [["car"]], "hedged": true}], "never": ["owner bought a second car", "owner bought an electric car", "owner owns an electric car"]},
    {"id": "h22", "cat": "hedge", "text": "Might learn the veena once Ilan is older; we'll see.", "expect": [{"about": "owner", "must": [["veena"]], "hedged": true}], "never": ["owner is learning veena", "owner is learning the veena", "owner plays the veena", "owner learns veena"]},
    {"id": "h23", "cat": "hedge", "text": "Deepa Sekar is thinking of opening a shop in Coimbatore.", "expect": [{"about": "Deepa", "must": [["deepa"], ["coimbatore"]], "hedged": true}], "never": ["deepa is opening a shop", "deepa opened a shop", "owner is opening a shop"]},
    {"id": "h24", "cat": "hedge", "text": "Maybe I'll quit tea altogether.", "expect": [{"about": "owner", "must": [["tea"]], "hedged": true}], "never": ["owner quit tea", "owner does not drink tea", "owner stopped drinking tea", "owner doesn't drink tea"]},
    {"id": "h25", "cat": "hedge", "text": "I could ask Deepa Iyer for a work-from-home day on Fridays, not sure she'll agree.", "expect": [{"about": "owner", "must": [["work from home", "work-from-home", "wfh", "remote"]], "hedged": true}], "never": ["owner works from home on fridays", "owner has a work-from-home day"]},
    {"id": "h26", "cat": "hedge", "text": "Senthil may get transferred to Chennai after March, nothing confirmed.", "expect": [{"about": "Senthil", "must": [["senthil"], ["chennai"]], "hedged": true}], "never": ["senthil is transferred", "senthil is moving to chennai", "senthil will move", "senthil has been transferred"]},
    {"id": "h27", "cat": "hedge", "text": "I want to run the Coimbatore half marathon next year.", "expect": [{"about": "owner", "must": [["marathon"]]}], "note": "firm intention, not a hedge"},
    {"id": "n13", "cat": "negation", "text": "I stopped the pottery classes.", "expect": [{"about": "owner", "must": [["pottery"]], "negate": true}], "never": ["owner attends pottery", "owner goes to pottery", "owner takes pottery"]},
    {"id": "n14", "cat": "negation", "text": "I don't use Instagram for the pickles anymore.", "expect": [{"about": "owner", "must": [["instagram"]], "negate": true}], "never": ["owner uses instagram for", "owner sells on instagram"]},
    {"id": "n15", "cat": "negation", "text": "I've stopped taking sugar in my tea.", "expect": [{"about": "owner", "must": [["sugar"]], "negate": true}], "never": ["owner takes sugar", "owner likes sugar in"]},
    {"id": "n16", "cat": "negation", "text": "I don't eat non-veg on Saturdays.", "expect": [{"about": "owner", "must": [["non-veg", "non veg", "nonveg", "meat"]], "negate": true}], "never": ["owner eats non-veg on saturday"]},
    {"id": "n17", "cat": "negation", "text": "I'm not buying a OnePlus, whatever Arun says.", "expect": [{"about": "owner", "must": [["oneplus", "one plus"]], "negate": true}], "never": ["owner is buying a oneplus", "owner bought a oneplus", "owner wants a oneplus", "owner uses a oneplus"]},
    {"id": "n18", "cat": "negation", "text": "We closed the gold scheme at Kanaga Jewellers.", "expect": [{"about": "owner", "must": [["gold"], ["clos"]]}], "never": ["owner pays 3,000", "owner pays into a gold", "owner contributes to a gold"]},
    {"id": "n19", "cat": "negation", "text": "Ilan doesn't need the inhaler any more.", "expect": [{"about": "Ilan", "must": [["ilan"], ["inhaler"]], "negate": true}], "never": ["ilan uses an inhaler", "ilan needs an inhaler"]},
    {"id": "n20", "cat": "negation", "text": "We no longer ship outside Tamil Nadu.", "expect": [{"about": "owner", "must": [["ship", "deliver", "courier"]], "negate": true}], "never": ["owner ships outside tamil nadu", "ships across india"]},
    {"id": "n21", "cat": "negation", "text": "I never drink coffee.", "expect": [{"about": "owner", "must": [["coffee"]], "negate": true}], "never": ["owner drinks coffee", "owner likes coffee"]},
    {"id": "n22", "cat": "negation", "text": "We aren't going to Ooty this year.", "expect": [{"about": "owner", "must": [["ooty"]], "negate": true}], "never": ["owner is going to ooty", "will go to ooty", "owner plans to go to ooty"]},
    {"id": "n23", "cat": "negation", "text": "Senthil doesn't play cricket anymore since his knee injury.", "expect": [{"about": "Senthil", "must": [["senthil"], ["cricket"]], "negate": true, "reason": [["knee", "injur"]]}], "never": ["senthil plays cricket every", "owner doesn't play cricket"]},
