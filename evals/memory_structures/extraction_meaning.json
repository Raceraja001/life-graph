{
  "about": "Synthetic extraction test (2026-10-31): does the extractor keep the MEANING of what the owner said? Each case is one owner message. 'expect' lists facts that must be extracted: 'must' groups must all match one fact's content (any alternative per group, case-insensitive); 'about' is who the fact is about ('owner' or a name the content must mention); 'negate' needs negation kept; 'hedged' needs the uncertainty kept (never a plain fact); 'reason' groups must appear in that fact; 'correction' expects the correction flag. 'never' lists phrases no extracted fact may contain (e.g. the owner given someone else's fact). 'none' cases must produce no facts.",
  "cases": [
    {"id": "s01", "cat": "subject", "text": "My colleague Ravi is learning Japanese for a trip next year.", "expect": [{"about": "Ravi", "must": [["ravi"], ["japanese"]]}], "never": ["owner is learning japanese", "owner wants to learn japanese", "owner plans to learn japanese"]},
    {"id": "s02", "cat": "subject", "text": "Senthil from work just bought an iPhone 16.", "expect": [{"about": "Senthil", "must": [["senthil"], ["iphone 16"]]}], "never": ["owner bought an iphone", "owner's phone is an iphone 16", "owner uses an iphone 16"]},
    {"id": "s03", "cat": "subject", "text": "My friend Anil lives in Velachery now.", "expect": [{"about": "Anil", "must": [["anil"], ["velachery"]]}], "never": ["owner lives in velachery"]},
    {"id": "s04", "cat": "subject", "text": "Arjun's wife Kavya runs a bakery in Coimbatore.", "expect": [{"about": "Kavya", "must": [["kavya"], ["bakery"]]}], "never": ["owner's wife kavya", "owner runs a bakery"]},
    {"id": "s05", "cat": "subject", "text": "There's a new designer on my team called Priya.", "expect": [{"about": "Priya", "must": [["priya"], ["designer"]]}], "never": ["owner's wife priya is a designer", "owner is a designer"]},
    {"id": "s06", "cat": "subject", "text": "Our neighbour Mr. Iyer drives a Tata Nexon EV.", "expect": [{"about": "Iyer", "must": [["iyer"], ["nexon"]]}], "never": ["owner drives a tata nexon", "owner's car is a tata nexon"]},
    {"id": "s07", "cat": "subject", "text": "Meena is vegetarian, so we always order from Saravana Bhavan for team lunches.", "expect": [{"about": "Meena", "must": [["meena"], ["vegetarian"]]}], "never": ["owner is vegetarian"]},
    {"id": "s08", "cat": "subject", "text": "Gopal hates long meetings even more than I do.", "expect": [{"about": "Gopal", "must": [["gopal"], ["meeting"]]}]},
    {"id": "s09", "cat": "subject", "text": "My brother-in-law Naveen is a doctor at Apollo in Bangalore.", "expect": [{"about": "Naveen", "must": [["naveen"], ["doctor"]]}], "never": ["owner is a doctor"]},
    {"id": "s10", "cat": "subject", "text": "Arjun prefers tabs over spaces, which drives me mad.", "expect": [{"about": "Arjun", "must": [["arjun"], ["tab"]]}], "never": ["owner prefers tabs"]},
    {"id": "s11", "cat": "subject", "text": "Anu's best friend Diya is allergic to milk.", "expect": [{"about": "Diya", "must": [["diya"], ["milk"]]}], "never": ["owner is allergic to milk", "anu is allergic"]},
    {"id": "s12", "cat": "subject", "text": "Divya says Bangalore traffic is getting worse; she's thinking of working from home.", "expect": [{"about": "Divya", "must": [["divya"], ["home"]], "hedged": true}], "never": ["owner is thinking of working from home"]},

    {"id": "n01", "cat": "negation", "text": "We decided not to buy a new car this year.", "expect": [{"about": "owner", "must": [["car"]], "negate": true}], "never": ["decided to buy a new car", "plans to buy a new car"]},
    {"id": "n02", "cat": "negation", "text": "I don't eat meat.", "expect": [{"about": "owner", "must": [["meat", "vegetarian"]], "negate": true}], "never": ["owner eats meat"]},
    {"id": "n03", "cat": "negation", "text": "I no longer use the iPhone; it's in a drawer.", "expect": [{"about": "owner", "must": [["iphone"]], "negate": true}], "never": ["owner uses an iphone", "owner's phone is an iphone"]},
    {"id": "n04", "cat": "negation", "text": "I stopped the veena classes after we moved.", "expect": [{"about": "owner", "must": [["veena"]], "negate": true}], "never": ["owner is learning the veena", "owner learns veena"]},
    {"id": "n05", "cat": "negation", "text": "We're not moving to Bangalore after all.", "expect": [{"about": "owner", "must": [["bangalore"]], "negate": true}], "never": ["owner is moving to bangalore", "owner plans to move to bangalore"]},
    {"id": "n06", "cat": "negation", "text": "I never drink coffee after 6 pm.", "expect": [{"about": "owner", "must": [["coffee"], ["6"]], "negate": true}]},
    {"id": "n07", "cat": "negation", "text": "I don't like WhatsApp groups at all.", "expect": [{"about": "owner", "must": [["whatsapp group"]], "negate": true}], "never": ["owner likes whatsapp groups"]},
    {"id": "n08", "cat": "negation", "text": "Anu doesn't take the school bus anymore; I drop her.", "expect": [{"about": "Anu", "must": [["anu"], ["bus"]], "negate": true}]},
    {"id": "n09", "cat": "negation", "text": "I won't renew the gym membership.", "expect": [{"about": "owner", "must": [["gym"]], "negate": true}], "never": ["owner will renew"]},
    {"id": "n10", "cat": "negation", "text": "I didn't pass the AWS Professional exam, will try again.", "expect": [{"about": "owner", "must": [["aws"]], "negate": true}], "never": ["owner passed the aws professional"]},
    {"id": "n11", "cat": "negation", "text": "No more Firebase for FarmLink.", "expect": [{"about": "owner", "must": [["firebase"]], "negate": true}], "never": ["farmlink uses firebase"]},
    {"id": "n12", "cat": "negation", "text": "Vicky isn't afraid of water any more.", "expect": [{"about": "Vicky", "must": [["vicky"], ["water"]], "negate": true}], "never": ["vicky is afraid of water"]},

    {"id": "h01", "cat": "hedge", "text": "Maybe I'll learn Japanese next year, not sure yet.", "expect": [{"about": "owner", "must": [["japanese"]], "hedged": true}], "never": ["owner is learning japanese", "owner speaks japanese"]},
    {"id": "h02", "cat": "hedge", "text": "I'm thinking about buying an electric car, maybe next year.", "expect": [{"about": "owner", "must": [["electric car", "ev"]], "hedged": true}], "never": ["owner bought an electric car", "owner decided to buy", "owner owns an electric car"]},
    {"id": "h03", "cat": "hedge", "text": "Might switch to a Pixel when my phone dies.", "expect": [{"about": "owner", "must": [["pixel"]], "hedged": true}], "never": ["owner uses a pixel", "owner's phone is a pixel"]},
    {"id": "h04", "cat": "hedge", "text": "Considering moving FarmLink to AWS later.", "expect": [{"about": "owner", "must": [["farmlink"], ["aws"]], "hedged": true}], "never": ["farmlink runs on aws", "farmlink moved to aws"]},
    {"id": "h05", "cat": "hedge", "text": "Not sure if we'll go to Munnar or Ooty this December.", "expect": [{"about": "owner", "must": [["munnar", "ooty"]], "hedged": true}], "never": ["going to munnar this december", "will go to munnar"]},
    {"id": "h06", "cat": "hedge", "text": "Possibly changing jobs next year if the right offer comes.", "expect": [{"about": "owner", "must": [["job"]], "hedged": true}], "never": ["owner is changing jobs", "owner will change jobs"]},
    {"id": "h07", "cat": "hedge", "text": "I may start running instead of walking.", "expect": [{"about": "owner", "must": [["running", "run"]], "hedged": true}], "never": ["owner runs every", "owner started running"]},
    {"id": "h08", "cat": "hedge", "text": "Thinking of getting a standing desk for home.", "expect": [{"about": "owner", "must": [["standing desk"]], "hedged": true}], "never": ["owner has a standing desk", "owner bought a standing desk"]},
    {"id": "h09", "cat": "hedge", "text": "We could visit Japan again in 2027, we'll see.", "expect": [{"about": "owner", "must": [["japan"]], "hedged": true}], "never": ["will visit japan in 2027", "plans to visit japan in 2027"]},
    {"id": "h10", "cat": "hedge", "text": "I might quit sugar completely.", "expect": [{"about": "owner", "must": [["sugar"]], "hedged": true}], "never": ["owner quit sugar", "owner does not eat sugar"]},
    {"id": "h11", "cat": "hedge", "text": "Perhaps Anu will join the chess club next term.", "expect": [{"about": "Anu", "must": [["anu"], ["chess"]], "hedged": true}], "never": ["anu joined the chess club", "anu is in the chess club"]},
    {"id": "h12", "cat": "hedge", "text": "I want to learn Rust properly this year.", "expect": [{"about": "owner", "must": [["rust"]]}], "note": "firm intention, not a hedge"},

    {"id": "r01", "cat": "reason", "text": "FarmLink is moving from Firebase to PostgreSQL because Firebase got too expensive.", "expect": [{"about": "owner", "must": [["postgres"]], "reason": [["expensive", "cost"]]}]},
    {"id": "r02", "cat": "reason", "text": "We moved to Chennai because of my new job at Tessera Labs.", "expect": [{"about": "owner", "must": [["chennai"]], "reason": [["job", "tessera"]]}]},
    {"id": "r03", "cat": "reason", "text": "I switched to a Pixel 9 because the iPhone battery kept dying.", "expect": [{"about": "owner", "must": [["pixel"]], "reason": [["battery"]]}]},
    {"id": "r04", "cat": "reason", "text": "We chose Kalakshetra School for Priya's job since it's close to home.", "expect": [{"about": "owner", "must": [["kalakshetra"]], "reason": [["close", "near"]]}]},
    {"id": "r05", "cat": "reason", "text": "I stopped the veena classes because they clashed with work calls.", "expect": [{"about": "owner", "must": [["veena"]], "negate": true, "reason": [["clash", "work"]]}]},
    {"id": "r06", "cat": "reason", "text": "We decided to prepay part of the home loan to save on interest.", "expect": [{"about": "owner", "must": [["prepay"]], "reason": [["interest"]]}]},
    {"id": "r07", "cat": "reason", "text": "I prefer WhatsApp messages because calls interrupt my focus.", "expect": [{"about": "owner", "must": [["whatsapp"]], "reason": [["interrupt", "focus"]]}]},
    {"id": "r08", "cat": "reason", "text": "We picked Munnar since the kids love the hills.", "expect": [{"about": "owner", "must": [["munnar"]], "reason": [["hill", "kids"]]}]},
    {"id": "r09", "cat": "reason", "text": "I walk at 6 am as it's cooler then.", "expect": [{"about": "owner", "must": [["walk"]], "reason": [["cool"]]}]},
    {"id": "r10", "cat": "reason", "text": "We dropped the Hyundai service centre due to their rude staff.", "expect": [{"about": "owner", "must": [["service"]], "negate": true, "reason": [["rude", "staff"]]}]},

    {"id": "c01", "cat": "correction", "text": "Actually, the swimming classes are at the YMCA pool in Nandanam, not Anna Nagar.", "expect": [{"about": "owner", "must": [["ymca", "nandanam"]], "correction": true}], "never": ["classes are at the anna nagar pool"]},
    {"id": "c02", "cat": "correction", "text": "No, my manager is Gopal now, not Meena.", "expect": [{"about": "owner", "must": [["gopal"]], "correction": true}], "never": ["manager is meena"]},
    {"id": "c03", "cat": "correction", "text": "Correction: Anu is in class 3, not class 2.", "expect": [{"about": "Anu", "must": [["anu"], ["3"]], "correction": true}], "never": ["anu is in class 2"]},
    {"id": "c04", "cat": "correction", "text": "Sorry, the EMI is 42,000 rupees, not 40,000.", "expect": [{"about": "owner", "must": [["42,000", "42000"]], "correction": true}], "never": ["emi is 40,000", "emi is 40000"]},
    {"id": "c05", "cat": "correction", "text": "Wait, Priya's birthday is 14 February, not the 15th.", "expect": [{"about": "Priya", "must": [["priya"], ["14"]], "correction": true}], "never": ["birthday is on the 15th", "15 february"]},
    {"id": "c06", "cat": "correction", "text": "It's a Pixel 9, not a Pixel 8.", "expect": [{"about": "owner", "must": [["pixel 9"]], "correction": true}], "never": ["phone is a pixel 8"]},
    {"id": "c07", "cat": "correction", "text": "Not Kochi — the December trip is to Munnar.", "expect": [{"about": "owner", "must": [["munnar"]], "correction": true}], "never": ["trip is to kochi"]},
    {"id": "c08", "cat": "correction", "text": "I was wrong earlier, Arjun is the CTO and I'm the CEO.", "expect": [{"about": "owner", "must": [["ceo", "cto"]], "correction": true}]},

    {"id": "d01", "cat": "numbers", "text": "Our household budget is 75,000 rupees a month now.", "expect": [{"about": "owner", "must": [["75,000", "75000", "75k"]]}]},
    {"id": "d02", "cat": "numbers", "text": "I put 15,000 a month into a Nifty index fund SIP.", "expect": [{"about": "owner", "must": [["15,000", "15000"], ["nifty", "index"]]}]},
    {"id": "d03", "cat": "numbers", "text": "Remember that my passport expires in June 2027.", "expect": [{"about": "owner", "must": [["passport"], ["june 2027", "2027-06"]]}]},
    {"id": "d04", "cat": "numbers", "text": "The home loan EMI is 42,000 rupees on the 5th of every month.", "expect": [{"about": "owner", "must": [["42,000", "42000"], ["5th", "fifth", "5 of", " 5 "]]}]},
    {"id": "d05", "cat": "numbers", "text": "Anu's birthday is 3 August.", "expect": [{"about": "Anu", "must": [["anu"], ["3 august", "august 3", "3rd august"]]}]},
    {"id": "d06", "cat": "numbers", "text": "We booked a homestay in Munnar from 23 to 27 December.", "expect": [{"about": "owner", "must": [["munnar"], ["23"], ["27"]]}]},
    {"id": "d07", "cat": "numbers", "text": "I walk 5 km every morning.", "expect": [{"about": "owner", "must": [["5 km", "5km", "five"]]}]},
    {"id": "d08", "cat": "numbers", "text": "Appa's 70th birthday party is on 9 January 2027 in Madurai.", "expect": [{"about": "owner", "must": [["70"], ["9 january", "january 9", "2027-01-09"]]}]},

    {"id": "t01", "cat": "tamil", "text": "என் மனைவி ப்ரியா கணக்கு டீச்சர்.", "expect": [{"about": "owner", "must": [["priya", "ப்ரியா"], ["math", "கணக்கு", "teacher", "டீச்சர்"]]}]},
    {"id": "t02", "cat": "tamil", "text": "நான் இனிமேல் காபி குடிக்க மாட்டேன்.", "expect": [{"about": "owner", "must": [["coffee", "காபி"]], "negate": true}], "never": ["owner drinks coffee", "owner likes coffee"]},
    {"id": "t03", "cat": "tamil", "text": "அடுத்த வருஷம் ஜப்பானிய மொழி கத்துக்கலாமான்னு யோசிக்கிறேன்.", "expect": [{"about": "owner", "must": [["japanese", "ஜப்பான"]], "hedged": true}], "never": ["owner is learning japanese", "owner speaks japanese"]},
    {"id": "t04", "cat": "tamil", "text": "எங்க அம்மாவுக்கு சர்க்கரை நோய் இருக்கு.", "expect": [{"about": "owner", "must": [["diabet", "sugar", "சர்க்கரை"]]}], "never": ["owner has diabetes", "owner is diabetic"]},
    {"id": "t05", "cat": "tamil", "text": "Priyavukku malli poo romba pidikkum.", "expect": [{"about": "Priya", "must": [["priya"], ["jasmine", "malli"]]}]},
    {"id": "t06", "cat": "tamil", "text": "நாங்க சென்னைக்கு வந்தது என் புது வேலைக்காக தான்.", "expect": [{"about": "owner", "must": [["chennai", "சென்னை"]], "reason": [["job", "work", "வேலை"]]}]},
    {"id": "t07", "cat": "tamil", "text": "என் போன் இப்போ பிக்சல் 9.", "expect": [{"about": "owner", "must": [["pixel", "பிக்சல்"]]}]},
    {"id": "t08", "cat": "tamil", "text": "ரவி ஜப்பானிய மொழி கத்துக்கிறான்.", "expect": [{"about": "Ravi", "must": [["ravi", "ரவி"], ["japanese", "ஜப்பான"]]}], "never": ["owner is learning japanese"]},

