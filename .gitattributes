* text=auto eol=lf

# Windows-only tooling — must stay CRLF to run under PowerShell
*.ps1 text eol=crlf

# POSIX scripts — must stay LF or the shebang breaks on the Linux VM
*.sh text eol=lf

# binaries — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
