# Environment Configuration
# Copy to .env and customize

# Database
LIFE_GRAPH_DATABASE_URL=postgresql+asyncpg://life_graph:life_graph@localhost:5432/life_graph
LIFE_GRAPH_DATABASE_URL_SYNC=postgresql://life_graph:life_graph@localhost:5432/life_graph

# LLM (via LiteLLM)
LIFE_GRAPH_LLM_MODEL_CHEAP=gemini/gemini-3.5-flash-lite
LIFE_GRAPH_LLM_MODEL_EXPENSIVE=gemini/gemini-3.6-flash
LIFE_GRAPH_LLM_DAILY_BUDGET_USD=1.0

# Vertex AI (Gemini via a separate GCP project's billing/quota; additive —
# leave LIFE_GRAPH_VERTEX_CREDENTIALS_PATH empty to leave it fully inactive)
LIFE_GRAPH_VERTEX_PROJECT=work-update-467706
LIFE_GRAPH_VERTEX_LOCATION=global
LIFE_GRAPH_VERTEX_CREDENTIALS_PATH=

# Embeddings (local, no API cost). The multilingual MiniLM fits an 8GB VM
# (~470MB); config.py defaults to BAAI/bge-m3 (1024-dim, ~2.3GB) which needs
# larger containers. Model and dimension MUST change together (null-and-rebuild
# of all pgvector columns; see workers/reembed.py).
LIFE_GRAPH_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LIFE_GRAPH_EMBEDDING_DIMENSION=384

# Multi-modal capture
# Cloudflare Workers AI transcription for Tanglish voice notes (free tier).
# Leave both empty to use local faster-whisper instead (private, weaker Tamil).
LIFE_GRAPH_CF_ACCOUNT_ID=
LIFE_GRAPH_CF_AI_TOKEN=
LIFE_GRAPH_GROQ_API_KEY=

# MinIO
LIFE_GRAPH_MINIO_ENDPOINT=localhost:9000
LIFE_GRAPH_MINIO_ACCESS_KEY=minioadmin
LIFE_GRAPH_MINIO_SECRET_KEY=minioadmin

# Multi-Modal (Voice)
WHISPER_MODEL=small
LIFE_GRAPH_WHISPER_MODEL=small

# API Authentication (leave empty to disable auth in dev mode)
LIFE_GRAPH_API_KEY=

# Debug
LIFE_GRAPH_DEBUG=false
LIFE_GRAPH_LOG_LEVEL=INFO

# OS Kernel
LIFE_GRAPH_KERNEL_MAX_CONCURRENT_TASKS=5
LIFE_GRAPH_KERNEL_DEFAULT_TIMEOUT=300
LIFE_GRAPH_KERNEL_DEFAULT_MAX_RETRIES=2
LIFE_GRAPH_KERNEL_TASK_CLEANUP_DAYS=30
LIFE_GRAPH_KERNEL_ENABLE_SCHEDULER=true
LIFE_GRAPH_KERNEL_MAX_CONSECUTIVE_FAILURES=3

# ── Personal AI ──────────────────────────────────────
LIFE_GRAPH_ADVISOR_MODELS=openrouter/openai/gpt-4o-mini,openrouter/deepseek/deepseek-chat,openrouter/meta-llama/llama-3.1-8b-instruct
LIFE_GRAPH_ADVISOR_TIMEOUT_SECONDS=10
LIFE_GRAPH_ADVISOR_MAX_COST_PER_QUERY=0.01
LIFE_GRAPH_RESEARCH_STALE_DAYS=30
LIFE_GRAPH_RESEARCH_MAX_PER_RUN=5
LIFE_GRAPH_RESEARCH_MONTHLY_BUDGET_USD=0.60
LIFE_GRAPH_RESEARCH_CONFIDENCE_THRESHOLD=0.7

# ── The Lifeline (backups, docker-compose.production.yml `backup` service) ──
BACKUP_RETENTION_DAYS=30
# Off-site encrypted backups via restic (optional; see docs/OPERATIONS.md)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# ── Capture Spine: Interview + Daily Brief ───────────
LIFE_GRAPH_INTERVIEW_MAX_QUESTIONS_PER_DAY=3
LIFE_GRAPH_INTERVIEW_QUESTION_TTL_DAYS=7
LIFE_GRAPH_BRIEF_HOUR_UTC=2

# ── Agent Drivers ─────────────────────────────────────
LIFE_GRAPH_DRIVER_CLAUDE_CODE_BIN=claude

# ── MCP (Model Context Protocol) Client Bridge ────────
# JSON list of external MCP servers to connect at startup and bridge into
# the tool registry. Two shapes — stdio (spawned as a subprocess of this
# process) and http (connects to an already-running server, e.g. its own
# container):
#   [{"name": ..., "command": ..., "args": [...], "env": {...}}]
#   [{"name": ..., "transport": "http", "url": "http://host:port/mcp"}]
# Default is [] — the bridge connects nothing and does nothing.
# LIFE_GRAPH_MCP_SERVERS=[]
# Example (production): Playwright MCP running as its own docker-compose
# service (see docker-compose.production.yml) —
# LIFE_GRAPH_MCP_SERVERS=[{"name":"playwright","transport":"http","url":"http://playwright-mcp:8931/mcp"}]

# ── Web Push Notifications (see scripts/gen_vapid_keys.py) ──
LIFE_GRAPH_VAPID_PUBLIC_KEY=
LIFE_GRAPH_VAPID_PRIVATE_KEY=
LIFE_GRAPH_VAPID_SUBJECT=

# --- Local transcript uploader (scripts/transcript_uploader.py) ---
# Configured via %USERPROFILE%\.life_graph_uploader.json, not env, but it needs:
#   backend_url, api_key (LIFE_GRAPH_API_KEY), tenant_id,
#   cf_access_client_id, cf_access_client_secret  (Cloudflare Access service token)
